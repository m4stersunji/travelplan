{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travelplan",
  "main": "_worker.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
